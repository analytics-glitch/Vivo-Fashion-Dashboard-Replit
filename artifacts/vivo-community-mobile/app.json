{
  "expo": {
    "name": "Vivo Johari",
    "slug": "vivo-community-mobile",
    "version": "1.0.0",
    "description": "Style, community and rewards from Vivo Johari.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vivo-johari",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fe5000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vivofashiongroup.johari",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Vivo Johari uses your camera when you choose to take a photo for a community post or virtual try-on.",
        "NSPhotoLibraryUsageDescription": "Vivo Johari uses your photo library when you choose a photo for a community post, profile, or virtual try-on.",
        "NSMicrophoneUsageDescription": "Vivo Johari uses your microphone only when you choose to record a video for a community post.",
        "NSLocationWhenInUseUsageDescription": "Vivo Johari uses your location only when you tap Use My Location to find a nearby Vivo store."
      }
    },
    "android": {
      "package": "com.vivofashiongroup.johari",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#fe5000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "vivo-johari", "host": "app" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
