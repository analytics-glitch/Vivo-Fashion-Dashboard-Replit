// ZETU Loyalty — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LOYALTY_APP_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Identity
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model Customer {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerified     Boolean  @default(false)
  firstName         String?
  lastName          String?
  avatarUrl         String?
  phone             String?
  birthday          DateTime?
  role              Role     @default(CUSTOMER)

  // Google OAuth
  googleId          String?  @unique

  // Shopify linkage (matched by email on first login / webhook)
  shopifyCustomerId String?  @unique

  // Loyalty state (denormalised for fast reads; ledger is source of truth)
  pointsBalance     Int      @default(0)
  lifetimePoints    Int      @default(0)
  tierId            String?
  tier              Tier?    @relation(fields: [tierId], references: [id])
  streakCount       Int      @default(0)
  lastActivityAt    DateTime?
  lastBirthdayGrant Int?     // year we last granted a birthday bonus

  // Active Shopify Storefront cart id, so the cart follows the account across devices.
  cartId            String?

  // Login / telemetry (for the admin dashboard)
  loginCount        Int      @default(0)
  lastLoginAt       DateTime?
  lastSeenAt        DateTime?   // heartbeat — powers "currently active"
  pwaInstalled      Boolean  @default(false)
  appVersion        String?     // build marker the client last reported

  // Referrals
  referralCode      String   @unique
  referredById      String?
  referredBy        Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals         Customer[] @relation("Referrals")

  transactions      PointsTransaction[]
  redemptions       Redemption[]
  referralsMade     Referral[] @relation("ReferrerReferrals")
  wishlist          WishlistItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tierId])
  @@index([referredById])
}

// ─────────────────────────────────────────────────────────────
//  Tiers
// ─────────────────────────────────────────────────────────────

model Tier {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  minPoints  Int        // lifetime points required to reach this tier
  multiplier Float      @default(1.0) // points earning multiplier
  color      String     @default("#6366f1")
  icon       String?    // emoji or icon key
  perks      Json       @default("[]") // string[] of perk descriptions
  sortOrder  Int        @default(0)

  customers  Customer[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([minPoints])
}

// ─────────────────────────────────────────────────────────────
//  Points ledger
// ─────────────────────────────────────────────────────────────

enum PointsType {
  EARN        // from a purchase
  REDEEM      // spent on a reward
  SIGNUP      // signup bonus
  BIRTHDAY    // birthday bonus
  REFERRAL    // referral reward
  STREAK      // streak bonus
  ADJUST      // manual admin adjustment
  EXPIRE      // points expiry
  REFUND      // reversal of earned points on refund/return
}

model PointsTransaction {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        PointsType
  points      Int        // positive = credit, negative = debit
  description String
  // References to source objects
  shopifyOrderId String?
  redemptionId   String?
  referralId     String?
  // Expiry for EARN credits (nullable = never)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([customerId, createdAt])
  @@index([shopifyOrderId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
//  Rewards & redemptions
// ─────────────────────────────────────────────────────────────

enum RewardType {
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  FREE_SHIPPING
  FREE_PRODUCT
}

model Reward {
  id          String       @id @default(cuid())
  title       String
  description String
  pointsCost  Int
  type        RewardType
  value       Float        @default(0) // percent (0-100) or fixed amount
  imageUrl    String?
  active      Boolean      @default(true)
  stock       Int?         // null = unlimited
  minTierId   String?      // optional tier gate
  sortOrder   Int          @default(0)

  redemptions Redemption[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active])
}

enum RedemptionStatus {
  ISSUED
  USED
  EXPIRED
  CANCELLED
}

model Redemption {
  id                  String           @id @default(cuid())
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId            String
  reward              Reward           @relation(fields: [rewardId], references: [id])
  pointsSpent         Int
  status              RedemptionStatus @default(ISSUED)
  // Shopify discount code generated for this redemption
  discountCode        String?          @unique
  shopifyPriceRuleId  String?
  shopifyDiscountId   String?
  expiresAt           DateTime?
  usedAt              DateTime?
  createdAt           DateTime         @default(now())

  @@index([customerId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Referrals
// ─────────────────────────────────────────────────────────────

enum ReferralStatus {
  PENDING     // invited, not yet converted
  COMPLETED   // referee placed qualifying order → rewards granted
  CANCELLED
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referrer     Customer       @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail String
  refereeId    String?        // set once the friend signs up
  status       ReferralStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  @@unique([referrerId, refereeEmail])
  @@index([refereeEmail])
}

// ─────────────────────────────────────────────────────────────
//  Email OTP (passwordless login for non-Google emails)
// ─────────────────────────────────────────────────────────────

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    // sha256 of the code
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Wishlist (saved products)
// ─────────────────────────────────────────────────────────────

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handle     String // storefront product handle
  title      String
  image      String?
  price      Float    @default(0)
  currency   String   @default("KES")
  createdAt  DateTime @default(now())

  @@unique([customerId, handle])
  @@index([customerId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Shopify webhook idempotency
// ─────────────────────────────────────────────────────────────

model ProcessedWebhook {
  id        String   @id @default(cuid())
  webhookId String   @unique // Shopify X-Shopify-Webhook-Id header
  topic     String
  createdAt DateTime @default(now())
}
