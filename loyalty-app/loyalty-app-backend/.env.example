# ─────────────────────────────────────────────────────────────
#  ZETU Loyalty — Backend environment
#  Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4001
HOST=0.0.0.0
# Public URL of this backend (used for OAuth callbacks & webhooks)
LOYALTY_APP_API_BASE_URL=http://localhost:4001
# Public URL of the React Router frontend (used for redirects & CORS)
LOYALTY_APP_WEB_BASE_URL=http://localhost:5173

# Single-origin hosting (production): serve the built SPA from this server.
# Set to true in prod so one HTTPS origin serves both the app and the API.
# See DEPLOY.md. In dev keep false (Vite serves the SPA on :5173).
LOYALTY_APP_SERVE_FRONTEND=false
LOYALTY_APP_FRONTEND_DIST=../the-loyalty-app/build/client

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://loyalty:loyalty@localhost:5435/loyalty?schema=public

# Auth / JWT — generate with: openssl rand -hex 32
LOYALTY_APP_JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime
LOYALTY_APP_JWT_EXPIRES_IN=30d
# Cookie name for the session token
LOYALTY_APP_SESSION_COOKIE=zetu_session
# Set to "true" in production (requires HTTPS)
LOYALTY_APP_COOKIE_SECURE=false

# Google OAuth — https://console.cloud.google.com/apis/credentials
LOYALTY_APP_GOOGLE_CLIENT_ID=
LOYALTY_APP_GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud console
LOYALTY_APP_GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/google/callback

# SMTP for OTP emails (Nodemailer). Works with Gmail, Mailgun, SES, Postmark…
LOYALTY_APP_SMTP_HOST=smtp.gmail.com
LOYALTY_APP_SMTP_PORT=587
LOYALTY_APP_SMTP_SECURE=false
LOYALTY_APP_SMTP_USER=
LOYALTY_APP_SMTP_PASS=
LOYALTY_APP_MAIL_FROM="Vivo Loyalty <rewards@shopzetu.com>"
# OTP config
LOYALTY_APP_OTP_TTL_MINUTES=10
LOYALTY_APP_OTP_LENGTH=6
LOYALTY_APP_OTP_MAX_ATTEMPTS=5

# Shopify Admin API (Custom App) — Settings → Apps → Develop apps
LOYALTY_APP_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
LOYALTY_APP_SHOPIFY_ADMIN_TOKEN=shpat_xxx
# Storefront API token (public) — powers in-app product detail + cart/checkout
LOYALTY_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
LOYALTY_APP_SHOPIFY_API_VERSION=2025-01
# Webhook HMAC verification secret (Shopify app "API secret key")
LOYALTY_APP_SHOPIFY_WEBHOOK_SECRET=

# Loyalty economics
LOYALTY_APP_POINTS_PER_CURRENCY=10          # points earned per 1 unit of currency spent
LOYALTY_APP_SIGNUP_BONUS_POINTS=200
LOYALTY_APP_BIRTHDAY_BONUS_POINTS=500
LOYALTY_APP_REFERRAL_REFERRER_POINTS=500    # points to the referrer when referee completes first order
LOYALTY_APP_REFERRAL_REFEREE_POINTS=250     # welcome points to the referred friend
LOYALTY_APP_POINTS_EXPIRY_MONTHS=12         # 0 = never expire

# Shop tab: public storefront + curated collection handles (comma-separated, ordered).
# Leave SHOP_COLLECTIONS empty to show all collections.
LOYALTY_APP_STOREFRONT_BASE_URL=https://www.shopzetu.com
LOYALTY_APP_SHOP_COLLECTIONS=vivo-collection,vivo-outerwear-1

# Admin dashboard access — comma-separated emails granted ADMIN role on login.
LOYALTY_APP_ADMIN_EMAILS=nigel@shopzetu.com
