modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sync Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shopify Full Extract"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "compile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "loyalty-smoke"

[[workflows.workflow]]
name = "Sync Watchdog"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WATCHDOG_MANAGE_API=0 python3 /home/runner/workspace/watchdog.py"

[[workflows.workflow]]
name = "Shopify Full Extract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 shopify_full_extract.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "compile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 check_python_syntax.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m unittest validation_agent.test_cross_surface validation_agent.test_governance validation_agent.test_learned_range test_ibt_nightly_reconcile validation_agent.test_ibt_calibration test_sync_loop_idempotency validation_agent.test_replen_calibration test_fabric_worker_loop test_production_intake_prune test_replen_item_history test_page_access_parity test_costing_signoff_rules test_costing_pdf_export test_sales_worker_loop test_sync_source_health test_preprod_costing_lines test_costing_multiplier_persistence test_costing_field_alignment test_merch_router_schema_smoke test_merch_buying_order_tab_access test_style_tier_seed test_community_style_quiz test_oauth_callback_redirect test_staff_login_cookie_session"

[[workflows.workflow]]
name = "loyalty-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 check_loyalty_smoke.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[run]
args = ["bash", "/home/runner/workspace/start_all.sh"]

[userenv]

