modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sync Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shopify Full Extract"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rebuild all_sales"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ShopZetu QL Backfill"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "compile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "Sync Watchdog"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WATCHDOG_MANAGE_API=0 python3 /home/runner/workspace/watchdog.py"

[[workflows.workflow]]
name = "Shopify Full Extract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 shopify_full_extract.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Rebuild all_sales"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 transform_all_sales.py"

[[workflows.workflow]]
name = "ShopZetu QL Backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 extract_shopzetu_sales.py --since=2022-01-01 --until=2026-06-13"

[[workflows.workflow]]
name = "compile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 check_python_syntax.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m unittest validation_agent.test_cross_surface test_ibt_nightly_reconcile validation_agent.test_ibt_calibration test_sync_loop_idempotency validation_agent.test_replen_calibration test_fabric_worker_loop"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8002
externalPort = 6000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18659
externalPort = 3000

[[ports]]
localPort = 20838
externalPort = 3001

[[ports]]
localPort = 20839
externalPort = 3003

[[ports]]
localPort = 21438
externalPort = 5000

[[ports]]
localPort = 22891
externalPort = 5173

[[ports]]
localPort = 26235
externalPort = 4200

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[run]
args = ["bash", "/home/runner/workspace/start_all.sh"]

