modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sync Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shopify Full Extract"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rebuild all_sales"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ShopZetu QL Backfill"

[[workflows.workflow]]
name = "Sync Watchdog"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WATCHDOG_MANAGE_API=0 python3 /home/runner/workspace/watchdog.py"

[[workflows.workflow]]
name = "Shopify Full Extract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 shopify_full_extract.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Rebuild all_sales"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 transform_all_sales.py"

[[workflows.workflow]]
name = "ShopZetu QL Backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 extract_shopzetu_sales.py --since=2022-01-01 --until=2026-06-13"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18659
externalPort = 80

[[ports]]
localPort = 20838
externalPort = 3003

[[ports]]
localPort = 21438
externalPort = 3001

[[ports]]
localPort = 22891
externalPort = 3002

[[ports]]
localPort = 26235
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[run]
args = ["bash", "/home/runner/workspace/start_all.sh"]

[userenv]

[userenv.shared]
WAREHOUSE_BINS_SHEET_ID = "1PDPHZttZbYFYaDyaopLG6_hiuZ2Te7qilN4xNI6s-0k"
